{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Network access stays in Rust; the webview may open GitHub and Slack links only, and the file picker for a mapping CSV (Rust reads the file).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://api.slack.com/*" },
        { "url": "https://*.slack.com/*" },
        { "url": "slack://*" }
      ]
    }
  ]
}

{
  "_metadata": {
    "major_version": 1
  },
  "display_information": {
    "name": "PR Nexus",
    "description": "Posts the code-review requests you approve in PR Nexus, as you, through the Slack MCP server."
  },
  "oauth_config": {
    "redirect_urls": [
      "http://127.0.0.1:47821/mcp/oauth/callback"
    ],
    "scopes": {
      "user": [
        "chat:write",
        "search:read.public",
        "search:read.private",
        "channels:read",
        "groups:read",
        "channels:history",
        "groups:history",
        "users:read"
      ],
      "user_optional": [
        "search:read.private"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "is_mcp_enabled": true
  }
}
